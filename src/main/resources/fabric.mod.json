{
  "schemaVersion": 1,
  "id": "village-mail",
  "version": "${version}",
  "name": "Village Mail",
  "description": "A postal system that feels like it was always part of Minecraft. Send letters with item attachments through the village post office, buy a mailbox from the local mail person, and receive deliveries. Server-side — works with vanilla clients.",
  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/village-mail"
  },
  "license": "MIT",
  "icon": "assets/village-mail/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "justfatlard.village_mail.Main"
    ],
    "client": [
      "justfatlard.village_mail.MainClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.18.0",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  },
  "suggests": {
    "village-quests": "*",
    "village-builder": "*"
  }
}
